# === Registre npm interne (entreprise) ===
# Remplace l'URL ci-dessous par celle de ton Artifactory/Nexus interne.
# Le registre npm public (registry.npmjs.org) est bloque par le proxy d'entreprise (403).
#
# Exemple type Artifactory :
#   registry=https://artifactory.<entreprise>.com/artifactory/api/npm/npm-virtual/
#
# Si un token est requis, NE LE COMMITE PAS. Utilise une variable d'environnement :
#   //artifactory.<entreprise>.com/artifactory/api/npm/npm-virtual/:_authToken=${NPM_TOKEN}
#
# >>> A COMPLETER <<<
registry=https://REGISTRE-INTERNE-A-COMPLETER/

# Certificat racine d'entreprise (interception TLS).
# Le bundle a deja ete genere : voir corp-ca.pem a la racine du projet.
cafile=./corp-ca.pem

# Proxy local de securite (agent type Zscaler detecte sur ce poste).
# Decommente si l'install echoue avec une erreur reseau :
# proxy=http://127.0.0.1:9000
# https-proxy=http://127.0.0.1:9000
